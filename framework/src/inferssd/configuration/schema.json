{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "InferSSD settings v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "expert.source": {
            "description": "Expert index source paths in declared order",
            "kind": "paths",
            "unit": "path",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-expert-source",
            "default_literal": "[]",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "default": []
        },
        "cpu.io_cpus": {
            "description": "Ordered unique CPU IDs for I/O participants",
            "kind": "cpus",
            "unit": "CPU ID",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-cpu-io-cpus",
            "default_literal": "",
            "type": "array",
            "uniqueItems": true,
            "maxItems": 65536,
            "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
            },
            "default": []
        },
        "cpu.decode_participants": {
            "description": "Decode compute participants; zero selects the measured/default policy",
            "kind": "integer",
            "unit": "compute participants",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-cpu-decode-participants",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "default": 0
        },
        "prefetch.depth": {
            "description": "Next-layer predicted experts, not a layer count or Mac read window",
            "kind": "integer",
            "unit": "predicted experts",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-prefetch-depth",
            "default_literal": "2",
            "type": "integer",
            "minimum": 0,
            "maximum": 64,
            "default": 2
        },
        "place.costs": {
            "description": "Measured placement cost terms; omitted terms retain calibrated priors",
            "kind": "costs",
            "unit": "named us and GB/s terms",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-place-costs",
            "default_literal": "",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cpu_fixed_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "cpu_route_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "drive_fixed_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "drive_gbps": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_fixed_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_host_fixed_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_host_route_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_route_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_token_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "link_gbps": {
                    "type": "number",
                    "maximum": 1000000,
                    "exclusiveMinimum": 0
                },
                "pageable_gbps": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                }
            },
            "default": {}
        },
        "prefill.cpu_max_tokens": {
            "description": "Largest CPU prefill ubatch; transitional v0.1 setting",
            "kind": "integer",
            "unit": "tokens",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-prefill-cpu-max-tokens",
            "default_literal": "4294967295",
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "default": 4294967295
        },
        "vram.budget": {
            "description": "Expert VRAM byte budget or auto",
            "kind": "budget",
            "unit": "bytes",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-vram-budget",
            "default_literal": "auto",
            "oneOf": [
                {
                    "const": "auto"
                },
                {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 68719476736
                }
            ],
            "default": "auto"
        },
        "vram.max_slots": {
            "description": "Maximum expert slots; zero leaves the resource-derived bound",
            "kind": "integer",
            "unit": "slots",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-vram-max-slots",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "default": 0
        },
        "vram.lookahead": {
            "description": "Highest-ranked experts the next layer's router predicts that go from RAM to the GPU tier ahead of their selection, as far as the link has time; zero waits for the selection",
            "kind": "integer",
            "unit": "predicted experts",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-vram-lookahead",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 16,
            "default": 0
        },
        "vram.warm_mib": {
            "description": "Device memory for low-precision copies of the experts the GPU tier evicts, requantized in place and served until the tier admits them again; changes results; zero keeps evicted experts on the CPU path",
            "kind": "integer",
            "unit": "MiB",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-vram-warm-mib",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 65536,
            "default": 0
        },
        "vram.warm_bits": {
            "description": "Precision of the copies vram.warm_mib keeps: 4 for Q4_0, 2 for Q2_0",
            "kind": "integer",
            "unit": "bits",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-vram-warm-bits",
            "default_literal": "4",
            "type": "integer",
            "minimum": 2,
            "maximum": 4,
            "default": 4
        },
        "vram.reserve_mib": {
            "description": "VRAM in MiB that prefill and decode leave free for other processes",
            "kind": "integer",
            "unit": "MiB",
            "producer": "launch",
            "scope": "linux",
            "cli": "--ssd-vram-reserve-mib",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 8192,
            "default": 0
        },
        "host.headroom_mib": {
            "description": "Host safety headroom in MiB",
            "kind": "integer",
            "unit": "MiB",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-host-headroom-mib",
            "default_literal": "512",
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "default": 512
        },
        "host.budget_mib": {
            "description": "Host memory envelope in MiB against this process's own memory; zero derives it at startup",
            "kind": "integer",
            "unit": "MiB",
            "producer": "plan",
            "scope": "darwin,windows",
            "cli": "--ssd-host-budget-mib",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 17592186044415,
            "default": 0
        },
        "decode.drop_mass": {
            "description": "Routing weight per layer that decode may drop among selected experts no expert cache holds, lowest weight first; trades fidelity for time and changes results",
            "kind": "integer",
            "unit": "percent of routing weight",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-decode-drop-mass",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "default": 0
        },
        "trace.capacity": {
            "description": "Requests the expert predictor keeps traced to match later prompts; zero predicts from the prompt, the last request and the usage profile alone",
            "kind": "integer",
            "unit": "requests",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-trace-capacity",
            "default_literal": "32",
            "type": "integer",
            "minimum": 0,
            "maximum": 1024,
            "default": 32
        },
        "trace.prior": {
            "description": "Start each request's decode in the GPU expert tier from its predicted expert selections",
            "kind": "integer",
            "unit": "boolean",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-trace-prior",
            "default_literal": "1",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 1
        },
        "trace.file": {
            "description": "At most one file that keeps the expert traces and usage profile across runs; empty keeps them for the process",
            "kind": "paths",
            "unit": "path",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-trace-file",
            "default_literal": "[]",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "default": []
        },
        "model.engram_prefetch": {
            "description": "Read ahead DeepSeek Engram rows; changes I/O timing only",
            "kind": "integer",
            "unit": "boolean",
            "producer": "model",
            "scope": "all",
            "cli": "--ssd-model-engram-prefetch",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
        },
        "model.hc_fused": {
            "description": "Use the fused hyper connection operations of DeepSeek-V4.1 and Qwen3.8-Flash-Next",
            "kind": "integer",
            "unit": "boolean",
            "producer": "model",
            "scope": "all",
            "cli": "--ssd-model-hc-fused",
            "default_literal": "1",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 1
        }
    }
}
